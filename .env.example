# Copiare in .env.local (webapp) e nelle variabili del worker. Mai committare valori reali.

# Database (Supabase, regione UE). Webapp: transaction pooler :6543. Worker: session pooler :5432.
# Non inserire sslmode nell'URL: il certificato va in EC_DATABASE_CA.
EC_DATABASE_URL=
EC_DATABASE_CA=
# Solo per il passo di rilascio `pnpm db:migrate` (connessione diretta o session pooler).
EC_DATABASE_URL_MIGRAZIONI=

# Cifratura applicativa (ADR 0004). Chiavi da 32 byte in base64: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# La chiave degli indici globali è distinta dalla chiave principale. Stesse chiavi per webapp e worker, diverse per ambiente.
EC_CHIAVE_PRINCIPALE_V1=
EC_CHIAVE_PRINCIPALE_ATTIVA=1
EC_CHIAVE_INDICI_GLOBALI=

# Google OAuth (progetto "Esterno", stato "In produzione" non verificato per il pilota).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Flusso proprio della webapp per Collega/Ricollega/Autorizza (registrarlo tra gli URI di reindirizzamento).
GOOGLE_REDIRECT_URI_CASELLE=http://localhost:3000/api/caselle/google/callback

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# URL pubblico della webapp (intestazioni verso OpenRouter, link nelle email di sistema).
EC_URL_APP=http://localhost:3000

# Notifiche Gmail via Pub/Sub (facoltative: senza, il worker interroga ogni minuto).
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
GCP_SERVICE_ACCOUNT_JSON=

# Solo sviluppo locale e CI: connettore e modelli simulati, dati sintetici. Vietato in produzione.
# APP_MODE=fake
